# Archivo .gitignore para un proyecto Ionic con Capacitor, Vite y pnpm

# Dependencias y archivos de bloqueo
# La carpeta node_modules es muy pesada y se puede reinstalar con 'pnpm install'
/node_modules
/pnpm-lock.yaml

# Archivos de construcción y distribución
# Estas carpetas se generan automáticamente al construir el proyecto
/dist
/www
/.angular

# Carpetas de plataformas nativas de Capacitor
# Estas carpetas son muy pesadas y se pueden regenerar con 'ionic cap add'
/android
/ios
/electron

# Archivos de configuración del editor y del IDE
# Para evitar conflictos de configuración entre diferentes desarrolladores
/.idea
/.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos de registro (logs)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos de entorno
# El archivo .env contiene claves secretas y configuraciones locales que no deben subirse
.env
.env.local
.env.*.local

# Archivos de caché y temporales de Vite
.vite/
.npm/
.pnpm-store/

# Cobertura de pruebas
/coverage

